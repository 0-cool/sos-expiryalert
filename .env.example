# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API Keys / Data API.
#
# Only PUBLIC values belong here. Variables prefixed with EXPO_PUBLIC_ are
# embedded in the app bundle and can be read by anyone who installs the app.
# Row Level Security (see supabase/migrations) is what protects the data.
#
# NEVER put the service_role key, a secret key (sb_secret_...) or the database
# password in this file or anywhere in the mobile app.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). If your project only shows the legacy
# "anon" key, you can paste that instead.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
