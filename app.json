{
  "expo": {
    "name": "SOS – ExpiryAlert",
    "slug": "sos-expiryalert",
    "scheme": "sosexpiryalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#F5F7FA",
    "ios": {
      "deploymentTarget": "15.5",
      "bundleIdentifier": "com.yourcompany.sosexpiryalert",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt",
          "fr"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.yourcompany.sosexpiryalert",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B2447",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B2447",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1020"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que SOS – ExpiryAlert use la cámara para leer el documento en el dispositivo. La imagen se elimina después del escaneo.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B2447",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "pt",
            "fr"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SOS – ExpiryAlert usa el micrófono solo cuando dictas un documento. El audio se procesa en el dispositivo y no se sube.",
          "speechRecognitionPermission": "SOS – ExpiryAlert usa el reconocimiento de voz en el dispositivo para completar los datos de un documento."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d8ba289e-8fd0-4c55-9c3a-cb77f44bf3c1"
      }
    }
  }
}
