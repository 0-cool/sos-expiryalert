{
  "expo": {
    "name": "SOS – ExpiryAlert",
    "slug": "sos-expiryalert",
    "scheme": "sosexpiryalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "fr": "./locales/fr.json"
    },
    "backgroundColor": "#F5F7FA",
    "ios": {
      "deploymentTarget": "15.5",
      "bundleIdentifier": "com.soscompany.expiryalert",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "es", "pt", "fr"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.soscompany.expiryalert",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B2447",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B2447",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1020"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SOS – ExpiryAlert uses the camera to scan documents on-device. Scanned images are deleted and never uploaded.",
          "microphonePermission": "SOS – ExpiryAlert uses the microphone only when you dictate a document. Audio is processed on-device and never uploaded.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B2447",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es", "pt", "fr"]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SOS – ExpiryAlert uses the microphone only when you dictate a document. Audio is processed on-device and never uploaded.",
          "speechRecognitionPermission": "SOS – ExpiryAlert uses on-device speech recognition to fill in document details. Your speech is never uploaded."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d8ba289e-8fd0-4c55-9c3a-cb77f44bf3c1"
      }
    }
  }
}
